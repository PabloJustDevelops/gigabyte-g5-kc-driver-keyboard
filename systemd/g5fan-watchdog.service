[Unit]
Description=Gigabyte G5 fan profile engine and thermal watchdog
Documentation=file:///usr/share/doc/g5kbd/FAN-RESEARCH.md
Documentation=file:///usr/share/doc/g5kbd/ROADMAP.md
After=systemd-modules-load.service g5kbd.service
# The daemon reaches the EC either through g5kbd (the firmware's own _DSM
# path) or through ec_sys, whose write_support=1 is set in
# /etc/modprobe.d/g5kbd.conf.
Wants=systemd-modules-load.service

[Service]
# Two jobs in one process, in this order of importance:
#   1. the thermal ceiling — above the CPU's own hwmon limit (90 °C if hwmon
#      has none) the fans go back to the firmware curve;
#   2. the selected curve profile (silent / maxq / custom) — the temperature
#      is turned into a duty for each fan, with hysteresis and a safety floor.
# `g5fan` releases the fans to the firmware curve on SIGTERM, and
# Restart=always brings it straight back after a crash or a SIGKILL. The EC's
# own firmware thermal protection runs independently of all of this, so a
# gap in the daemon can never be the thing that overheats the CPU.
# What this daemon can see is republished to /run/g5fan/status.json on every
# tick, so the desktop panel can show the fans without a password prompt and
# without the raw EC. RuntimeDirectory creates (and cleans up) /run/g5fan;
# `g5fan status --cached` reads it, and its age is how a reader tells a live
# daemon from one that died.
RuntimeDirectory=g5fan
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/g5fan supervise --interval 5
Restart=always
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
