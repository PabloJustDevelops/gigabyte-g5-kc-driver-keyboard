logs/
dsdt.dat

# python
__pycache__/
*.pyc

# makepkg build dirs
pkg/
*.pkg.tar.*
*.src.tar.*

# panel (gpui / cargo)
gui/target/

# leftovers from the removed web build. `sudo ./install.sh` used to run
# npm install as root, so these trees are root-owned and cannot be deleted by
# a normal user; they are ignored so they can never be committed. Remove them
# with:  sudo rm -rf gui/node_modules gui/dist
gui/node_modules/
gui/dist/

# kernel module build artifacts
kernel/*.o
kernel/*.ko
kernel/*.mod
kernel/*.mod.c
kernel/.*.cmd
kernel/Module.symvers
kernel/modules.order

# local agent tooling (not part of the project)
.agents/
.claude/
.commandcode/
skills-lock.json
